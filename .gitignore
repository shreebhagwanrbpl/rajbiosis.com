# Dependencies (कभी भी git में नहीं डालने चाहिए क्योंकि ये npm i से install होते हैं)
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output (Next.js का build folder)
/.next/
/out/

# Production build
/build
/dist

# Testing & coverage
/coverage

# Environment variables & secret keys (.env files को सुरक्षित रखने के लिए)
.env*.local
.env
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & OS files
.DS_Store
Thumbs.db
*.pem

# Editor & IDE configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel deployment
.vercel

# TypeScript build info
*.tsbuildinfo
next-env.d.ts
